{
  "name": "matsunoya",
  "version": "0.1.0",
  "private": true,
  "main": "tools/matsunoya.js",
  "scripts": {
    "collect": "node tools/matsunoya.js",
    "build:pug": "pug src -O src/variables.json -o docs",
    "build:sass": "sass src/*.scss docs/stylesheets/style.css",
    "build": "npm run build:pug && npm run build:sass",
    "watch:sass": "sass --watch src/*.scss docs/stylesheets/style.css",
    "watch": "node tools/watch.js"
  },
  "dependencies": {
    "pug": "^3.0.4",
    "puppeteer": "^25.16.0"
  },
  "allowScripts": {
    "puppeteer": true,
    "@parcel/watcher": true,
    "core-js": true
  },
  "devDependencies": {
    "pug-cli": "^1.0.0-alpha6",
    "sass": "^1.106.1"
  }
}
